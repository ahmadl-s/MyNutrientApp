<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="370.0" prefWidth="600.0" styleClass="main-window" stylesheets="@../../application.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="MyNutritionapp.view.MainWindowController">
    <children>
        <SplitPane dividerPositions="0.32" prefHeight="400.0" prefWidth="600.0" styleClass="main-split-pane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0" styleClass="sidebar-pane">
                    <children>
                        <VBox spacing="12.0" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="16.0">
                            <children>
                                <Label styleClass="section-kicker" text="FOOD LIBRARY" />
                                <Label styleClass="page-title" text="Browse the database" wrapText="true" />
                                <Label styleClass="section-subtitle" text="Select a food item to inspect its nutrition profile." wrapText="true" />
                                <TableView fx:id="foodTableView" styleClass="food-table" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="foodNameColumn" prefWidth="220.0" text="Food Name" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="398.0" prefWidth="406.0" styleClass="details-pane">
                    <children>
                        <VBox spacing="16.0" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="18.0" AnchorPane.rightAnchor="18.0" AnchorPane.topAnchor="16.0">
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="section-kicker" text="NUTRITION SNAPSHOT" />
                                        <Label styleClass="page-title" text="Food Details" />
                                        <Label styleClass="section-subtitle" text="Detailed information for the selected item." wrapText="true" />
                                    </children>
                                </VBox>
                                <GridPane hgap="14.0" styleClass="details-card" vgap="12.0">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="110.0" prefWidth="130.0" />
