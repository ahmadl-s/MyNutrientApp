                                        <Label fx:id="caloriesLabel" styleClass="detail-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                        <Label styleClass="detail-label" text="Protein" GridPane.rowIndex="2" />
                                        <Label fx:id="proteinLabel" styleClass="detail-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                        <Label styleClass="detail-label" text="Carbohydrates" GridPane.rowIndex="3" />
                                        <Label fx:id="carbohydratesLabel" styleClass="detail-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                        <Label styleClass="detail-label" text="Fat" GridPane.rowIndex="4" />
                                        <Label fx:id="fatLabel" styleClass="detail-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                        <Label styleClass="detail-label" text="Fiber" GridPane.rowIndex="5" />
                                        <Label fx:id="fiberLabel" styleClass="detail-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                        <Label styleClass="detail-label" text="Sugar" GridPane.rowIndex="6" />
                                        <Label fx:id="sugarLabel" styleClass="detail-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                                        <Label styleClass="detail-label" text="Type" GridPane.rowIndex="7" />
                                        <Label fx:id="foodTypeLabel" styleClass="detail-value" text="—" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                                    </children>
                                </GridPane>
                                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#handleInstructionWindow" styleClass="btn-secondary" text="Instructions" />
                                        <Button mnemonicParsing="false" onAction="#handleCombineWindow" styleClass="btn-primary" text="Combine" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
